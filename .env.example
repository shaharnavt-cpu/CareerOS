# Public URL used by the frontend when API integration is introduced.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local PostgreSQL 16 container configuration.
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros
POSTGRES_PORT=5432

# Shared SQLAlchemy and Alembic database configuration.
DATABASE_URL=postgresql+psycopg://careeros:careeros@localhost:5432/careeros
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Deterministic local reasoning completes the development pipeline without an
# external API key. Production can set this to openai-compatible and configure
# LLM_API_KEY plus LLM_MODEL below.
REASONING_PROVIDER=local-deterministic
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your-provider-model
LLM_TIMEOUT_SECONDS=30

# Application Package Builder writing provider. The local default requires no
# model key. Keep OPENAI_API_KEY in an untracked .env file or process
# environment; never commit it or send it to the browser.
APPLICATION_WRITER_PROVIDER=local-deterministic
APPLICATION_WRITER_DATA_POLICY=private
OPENAI_API_KEY=
OPENAI_APPLICATION_WRITER_MODEL=gpt-5.6-terra
OPENAI_APPLICATION_REVIEW_MODEL=
OPENAI_APPLICATION_ENABLE_REVIEW_PASS=false
OPENAI_APPLICATION_TIMEOUT_SECONDS=120
OPENAI_APPLICATION_MAX_OUTPUT_TOKENS=6000
OPENAI_APPLICATION_MAX_INPUT_CHARACTERS=80000
OPENAI_APPLICATION_MAX_SELECTED_MEMORIES=4
OPENAI_APPLICATION_REASONING_EFFORT=medium
RUN_LIVE_OPENAI_TESTS=false
CORS_ORIGINS=http://localhost:3000
